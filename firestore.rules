rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Pillar 1)
    match /{document=**} {
      allow read, write: if false;
    }

    // Changelogs Collection Rules (Public read/write for AI changelogs)
    match /changelogs/{changelogId} {
      allow read, write: if true;
    }

    // Primitive Definitions & Helpers (Pillar 3)
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Device Counters Rules (Contadores Sequenciais por Operador)
    match /device_counters/{cleanPrefix} {
      allow read, write: if true;
    }

    // Registered Devices Rules (Dispositivos Cadastrados)
    match /registered_devices/{deviceTag} {
      allow read, write: if true;
    }

    // Helper to check if batch is closed
    function isBatchClosed(batchId) {
      return exists(/databases/$(database)/documents/batches/$(batchId)) &&
        get(/databases/$(database)/documents/batches/$(batchId)).data.isClosed == true;
    }

    // Batches Collection Rules
    match /batches/{batchId} {
      
      function isValidBatch(data) {
        return data.keys().hasAll(['id', 'name', 'description', 'type', 'timestamp', 'isClosed']) &&
          data.id is number &&
          data.name is string && data.name.size() >= 1 && data.name.size() <= 200 &&
          data.description is string && data.description.size() <= 1000 &&
          data.type is string && (data.type == 'COLLECTION' || data.type == 'VERIFICATION') &&
          data.timestamp is number &&
          data.isClosed is bool &&
          (!data.keys().contains('createdBy') || data.createdBy is string) &&
          (!data.keys().contains('lastUploadedBy') || data.lastUploadedBy is string) &&
          (!data.keys().contains('updatedAt') || data.updatedAt is number) &&
          (!data.keys().contains('closedReason') || data.closedReason is string) &&
          (!data.keys().contains('closedAt') || data.closedAt == null || data.closedAt is number) &&
          (!data.keys().contains('ownerUid') || data.ownerUid is string);
      }

      allow create, read, update, delete: if true;

      // ScanItems Subcollection
      match /scanItems/{itemId} {
        function isValidScanItem(data) {
          return data.keys().hasAll(['id', 'batchId', 'barcode', 'format', 'timestamp']) &&
            data.id is number &&
            data.batchId is number &&
            data.barcode is string && data.barcode.size() >= 1 && data.barcode.size() <= 128 &&
            data.format is string && data.format.size() <= 50 &&
            data.timestamp is number;
        }

        allow create, read, update, delete: if true;
      }

      // ExpectedItems Subcollection
      match /expectedItems/{itemId} {
        function isValidExpectedItem(data) {
          return data.keys().hasAll(['id', 'batchId', 'barcode', 'description', 'category', 'isFound']) &&
            data.id is number &&
            data.batchId is number &&
            data.barcode is string && data.barcode.size() >= 1 && data.barcode.size() <= 128 &&
            data.description is string && data.description.size() <= 500 &&
            data.category is string && data.category.size() <= 100 &&
            data.isFound is bool &&
            (!data.keys().contains('timestampFound') || data.timestampFound == null || data.timestampFound is number);
        }

        allow create, read, update, delete: if true;
      }

      // AuditLogs Subcollection
      match /auditLogs/{logId} {
        function isValidAuditLog(data) {
          return data.keys().hasAll(['id', 'batchId', 'timestamp', 'type', 'message']) &&
            data.id is number &&
            data.batchId is number &&
            data.timestamp is number &&
            data.type is string && data.type.size() <= 50 &&
            (!data.keys().contains('barcode') || data.barcode == null || data.barcode is string) &&
            data.message is string && data.message.size() <= 1000;
        }

        allow create, read, update: if true;
        allow delete: if false;
      }
    }
  }
}
